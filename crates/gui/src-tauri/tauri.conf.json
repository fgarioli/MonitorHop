{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MonitorHop",
  "version": "0.1.0",
  "identifier": "io.github.fgarioli.monitorhop",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../frontend"
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../frontend"
    },
    "devUrl": "http://localhost:1420",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "MonitorHop",
        "width": 480,
        "height": 640,
        "visible": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
